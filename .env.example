# Aladdin WSP — Hindi / Hinglish weight-space programming
# Copy to .env, fill in, then:  set -a; . ./.env; set +a
# NEVER commit .env — it is in .gitignore.

# --- NVIDIA reasoning/editing agent (required for --agent nvidia) ---
# Paste your key after the '=' (keys start with nvapi-, but never commit a real one)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Verified against the public catalogue (see docs/NVIDIA_MODEL.md);
# run `python -m aladdin.cli nvidia-models` to list what YOUR key can call.
NVIDIA_MODEL=
# optional second model used only as an LLM judge for naturalness
NVIDIA_JUDGE_MODEL=

# --- required runtime model (after `aladdin download`) ---
# This is the MIT WSP researcher's ALREADY-EDITED checkpoint. It is the default
# everywhere; do not replace it with Qwen/Qwen3.5-0.8B.
ALADDIN_MODEL_ID=RikiyaT/Qwen3.5-0.8B-weight-space-programming
ALADDIN_BACKEND=hf_torch
ALADDIN_LOAD_MODE=text
ALADDIN_MODEL_PATH=./models/Qwen3.5-0.8B-weight-space-programming
ALADDIN_DEVICE=cuda

# --- optional: HF token, only if the model repo is gated ---
# HF_TOKEN=
